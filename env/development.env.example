# =============================================================================
# Vizra — development environment template.
#
# Copy to env/development.env (gitignored) and use it with a BARE
# `docker compose`, which auto-loads docker-compose.override.yml:
#
#   docker compose --env-file env/development.env \
#     --profile core --profile frontend up
#
# THIS FILE IS NOT A PRODUCTION FILE AND CANNOT BECOME ONE. The seams at the
# bottom are refused by name when vizra-core runs with VIZRA_MODE=production,
# and they reach a container only through docker-compose.override.yml, which the
# production `-f` chain never loads. `scripts/check-compose-topology.py` asserts
# that no production shape renders a single VIZRA_DEV_* key or anything but
# VIZRA_MODE=production.
#
# Secrets below are local-only and deliberately boring. Do not copy any of them
# into env/production.env: vizra-core and vizra-search both refuse a list of
# published test values by exact match, so a copied value fails at boot rather
# than shipping — but it fails on the host, in front of a user, which is late.
# =============================================================================

VIZRA_IMAGE_REGISTRY=ghcr.io
VIZRA_IMAGE_OWNER=yegamble
# A bare `docker compose` runs the images the base file names. Add
# `-f docker-compose.dev.yml` to build from ./vizra-core, ./vizra-user and
# ./vizra-search instead.
VIZRA_CORE_TAG=dev
VIZRA_USER_TAG=dev
VIZRA_SEARCH_TAG=dev

VIZRA_PUBLIC_ORIGIN=http://127.0.0.1:3000
VIZRA_SITE_HANDLE=default

VIZRA_SESSION_SECRET=local-development-session-secret-0000
VIZRA_MFA_KEY_KEK=local-development-mfa-kek-00000000000
SEARCH_HMAC_KEY=local-development-search-hmac-key-000000000000

POSTGRES_USER=vizra
POSTGRES_DB=vizra
POSTGRES_PASSWORD=local-development-postgres-password

# Blank unless you add the matching external overlay.
DATABASE_URL=
VIZRA_CACHE_URL=

VALKEY_MAXMEMORY=128mb
VIZRA_CACHE_NAMESPACE=default

VIZRA_HTTP_PORT=8080
VIZRA_FRONTEND_PORT=3000

VIZRA_STORAGE_PREFIX=default

VIZRA_SEARCH_MODE=off
VIZRA_SEARCH_URL=http://search:8081
VIZRA_SEARCH_TIMEOUT=2s

MAX_INTERNAL_BODY_BYTES=1048576
VIZRA_SEARCH_MAX_CLOCK_SKEW=300s
VIZRA_SEARCH_REQUEST_TIMEOUT=5s
VIZRA_SEARCH_SHUTDOWN_GRACE=15s

API_TIMEOUT_MS=10000

VIZRA_CORS_ALLOWED_ORIGINS=
VIZRA_ALLOW_INSECURE_PUBLIC_ORIGIN=
VIZRA_QUEUE_AGE_THRESHOLD=15m
VIZRA_WORKER_CONCURRENCY=2
VIZRA_JOB_LEASE=60s
VIZRA_JOB_TIMEOUT=5m
VIZRA_SHUTDOWN_GRACE=5s
VIZRA_MIGRATE_LOCK_TIMEOUT=5s

CLICKHOUSE_USER=vizra
CLICKHOUSE_DB=vizra
CLICKHOUSE_PASSWORD=

IPFS_PROFILE=server


# -----------------------------------------------------------------------------
# DEVELOPMENT SEAMS — every one of these is refused in production, by name
# -----------------------------------------------------------------------------
# They reach a container only via docker-compose.override.yml. Leave them empty
# unless you need the specific thing each one removes; an empty value is off.
#
# VIZRA_DEV_AUTOLOGIN_USER is refused on PRESENCE with a non-empty value, not
# merely on truthiness — so setting it and forgetting is a boot failure, which
# is the intended behaviour.
VIZRA_DEV_DISABLE_AUTH=
VIZRA_DEV_ALLOW_ANY_ORIGIN=
VIZRA_DEV_SKIP_MIGRATIONS=
VIZRA_DEV_AUTOLOGIN_USER=
VIZRA_DEV_FAKE_SEARCH=
VIZRA_DEV_INSECURE_COOKIES=
VIZRA_DEV_TRUST_ANY_HMAC=

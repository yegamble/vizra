# =============================================================================
# Vizra — production environment template.
#
# COPY THIS FILE TO env/production.env AND FILL IT IN. That copy is gitignored
# and it holds the keys that seal your data: losing VIZRA_MFA_KEY_KEK loses
# every stored MFA secret. Back it up with the database, not instead of it.
#
# HOW A KEY HERE REACHES A CONTAINER
#   It reaches one because a compose file's `environment:` map names it with
#   `${THIS_KEY}`. There is no `env_file:` on any service and no wildcard
#   passthrough, which is deliberate: it is what keeps VIZRA_MFA_KEY_KEK out of
#   the frontend container and what keeps vizra-core's VIZRA_SEARCH_MODE
#   (off|managed|external) away from vizra-search, which reads a key of the same
#   name with a different vocabulary and refuses to boot on the wrong one.
#
#   A KEY ADDED HERE WITH NO `${...}` CONSUMER DOES NOTHING, and
#   `./scripts/check-config-coverage.py` fails on exactly that — in both
#   directions. Do not add a key here speculatively.
#
# REQUIRED VALUES SHIP BLANK, ON PURPOSE. The compose files spell them
# `${KEY:?message}`, which refuses to render on an unset OR EMPTY value, so a
# half-filled file fails loudly at render time instead of booting with a
# published placeholder. The messages name the variable and never echo a value.
#
# WHAT THIS FILE DOES NOT YET CARRY, and why (so you do not go looking):
#   VIZRA_TLS_MODE, VIZRA_ACME_EMAIL, VIZRA_EXTERNAL_POSTGRES,
#   VIZRA_EXTERNAL_REDIS, INSTANCE_NAME, STORAGE_BACKEND / STORAGE_S3_*,
#   ANALYTICS_MODE, IPFS_MODE, MAIL_ENABLED / SMTP_*, REGISTRATION_*,
#   GUEST_UPLOAD_*, IMPORT_*.
#   docs/META_REPO.md §3 lists them as questions for `vizra setup`, which does
#   not exist yet (VZ-ISSUE-004). Nothing reads them — no installer, no engine
#   and no component key —
#   and a key nobody reads is a lie an operator can act on. They arrive with the
#   slices that give them a reader (VZ-ISSUE-003 and VZ-ISSUE-004, plus the
#   storage, mail and registration slices). Until then the topology is selected with explicit
#   `--profile` and `-f` arguments; see docs/quality/COMMANDS.md.
#
#   Also absent: a storage root. The `vizra_media_data` volume is mounted on api
#   and worker, and NOTHING WRITES TO IT until VZ-MEDIA-001 — vizra-core has no
#   storage-root key at M0 (VIZRA_STORAGE_PREFIX is a key prefix, never a path).
#   If you back that volume up today you will archive an empty volume and
#   believe your originals are safe. They are not there yet.
# =============================================================================


# -----------------------------------------------------------------------------
# Release record — which artefacts this host runs
# -----------------------------------------------------------------------------
# VIZRA IMAGES ARE PUBLISHED FOR linux/amd64 ONLY (Q-027). An arm64 host —
# Ampere, Graviton, Hetzner ARM — is NOT supported: the third-party images below
# are multi-arch, so PostgreSQL and Valkey start happily and then the migrate
# one-shot fails with `no matching manifest for linux/arm64/v8`, which is the
# most confusing possible place to learn your host is unsupported. There is no
# preflight yet: install.sh (VZ-ISSUE-004) will refuse a non-amd64 server host
# by name before pulling anything, but until it lands nothing checks for you.
# Apple Silicon developers build from the checkouts instead:
# see docker-compose.dev.yml.
#
# A deploy and its rollback must name the same artefacts. These come from
# releases/<tag>.json; `docker-compose.prod.yml` spells them `${...:?}`, so a
# production render with any of them blank FAILS rather than running `:dev`.
VIZRA_IMAGE_REGISTRY=ghcr.io
VIZRA_IMAGE_OWNER=yegamble
VIZRA_CORE_TAG=
VIZRA_USER_TAG=
VIZRA_SEARCH_TAG=


# -----------------------------------------------------------------------------
# Origin
# -----------------------------------------------------------------------------
# The origin browsers use, scheme included, no trailing slash. It is the value
# both vizra-core and vizra-user need to agree on for links and cookies to work
# (vizra-user reads it as PUBLIC_ORIGIN; one key feeds both).
VIZRA_PUBLIC_ORIGIN=

# Which site in a multi-site instance this process serves.
VIZRA_SITE_HANDLE=default


# -----------------------------------------------------------------------------
# Secrets — generate every one; never reuse a value from any repository
# -----------------------------------------------------------------------------
# openssl rand -base64 32
# Changing this after first boot SIGNS EVERY MEMBER OUT — every session cookie
# stops verifying at once. Recoverable: people log in again.
VIZRA_SESSION_SECRET=
# openssl rand -base64 32
#
# ***  DO NOT CHANGE THIS VALUE BY HAND AFTER FIRST BOOT.  ***
#
# It seals stored MFA secrets. Editing it here does NOT re-seal them: every TOTP
# secret in the database stays sealed under the OLD key and becomes permanently
# undecryptable, and every MFA-enrolled member is locked out with no recovery
# short of an admin disabling MFA account by account.
#
# Nothing in Vizra re-seals them today. `vizra` has three subcommands — version,
# doctor, migrate. Re-sealing rotation arrives with `vizra setup --rotate` in
# VZ-ISSUE-004, and this block changes in the same PR that implements it.
#
# Back this file up wherever you back up the database. Losing it is the same as
# changing it.
VIZRA_MFA_KEY_KEK=
# openssl rand -hex 32
# The core<->search shared secret. vizra-core and vizra-search must hold the
# same value at the same instant — there is no rotation window — so this one key
# is fed to both services under each one's own spelling.
SEARCH_HMAC_KEY=


# -----------------------------------------------------------------------------
# Bundled PostgreSQL (MANAGED)
# -----------------------------------------------------------------------------
# Used when you do NOT add -f docker-compose.external-postgres.yml.
POSTGRES_USER=vizra
POSTGRES_DB=vizra
# openssl rand -base64 24
# STILL REQUIRED EVEN WITH AN EXTERNAL DATABASE. Compose interpolates every
# file it loads before profiles are evaluated, so this reference is resolved
# whether or not the bundled service ends up in the model. With an external
# database put any non-empty placeholder here; nothing reads it.
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# External datastores (EXTERNAL) — only with the matching overlay
# -----------------------------------------------------------------------------
# Leave both blank unless you add the overlay; blank is what makes the overlay's
# refusal fire instead of a silent fallback to a fresh local database.
#
#
# EXTERNAL PostgreSQL: WHAT YOU MUST SET. Four things, and nothing else:
#   1. DATABASE_URL below — the full DSN, sslmode included. `sslmode=require` is
#      recommended; `sslmode=disable` is accepted and nothing warns you today
#      (`vizra doctor` will, VZ-ISSUE-004).
#   2. POSTGRES_PASSWORD above — any non-empty placeholder. Nothing reads it;
#      Compose interpolates every file it loads before profiles are evaluated,
#      so the reference is resolved whether or not the bundled service survives.
#   3. `-f docker-compose.external-postgres.yml` appended to your compose chain.
#      Without it the bundled database is still there and DATABASE_URL is ignored.
#   4. YOUR OWN SNAPSHOT/PITR SCHEDULE. Backup ownership is yours and nothing
#      in Vizra takes it back: no tool here dumps a database it does not manage,
#      and none will. Set the provider's schedule up now and rehearse a restore
#      — do not defer it pending a Vizra backup tool. (backup.sh, which will
#      refuse such a database out loud, arrives with VZ-ISSUE-004.)
#
#   -f docker-compose.external-postgres.yml
DATABASE_URL=
#   -f docker-compose.external-redis.yml
# Valkey or Redis >= 7.2, or a managed equivalent. rediss:// for TLS.
VIZRA_CACHE_URL=


# -----------------------------------------------------------------------------
# Bundled cache (MANAGED)
# -----------------------------------------------------------------------------
# Eviction is safe: durable work lives in PostgreSQL, so an evicted key costs
# latency and never data. Nothing backs the cache up today; backup.sh
# (VZ-ISSUE-004) will refuse to, and say why.
VALKEY_MAXMEMORY=256mb
VIZRA_CACHE_NAMESPACE=default


# -----------------------------------------------------------------------------
# Loopback publish ports
# -----------------------------------------------------------------------------
# These are bound to 127.0.0.1 and nowhere else. Change them only if something
# else on the host already owns the port; they are not a way to expose a service.
VIZRA_HTTP_PORT=8080
VIZRA_FRONTEND_PORT=3000
#
# DIAGNOSING THIS RELEASE: IGNORE THE `healthy` COLUMN.
# `docker compose ps` reports api and worker healthy whenever the binary can
# execute — their probe is `vizra version`, which never opens a socket and never
# touches PostgreSQL. `docker compose up -d --wait` returns success against a
# wedged api for the same reason. frontend's probe is liveness-only too: it says
# the process renders, not that vizra-core is reachable.
#
# Ask the API itself instead. The loopback publish above exists for this (the
# ports are VIZRA_HTTP_PORT and VIZRA_FRONTEND_PORT, set two lines up):
#     curl -fsS http://127.0.0.1:8080/healthz   # liveness
#     curl -sS  http://127.0.0.1:8080/readyz; echo
#                                               # NO -f HERE. /readyz answers 200
#                                               # "degraded" when the cache is down,
#                                               # search is misconfigured or the queue
#                                               # is backed up, and -f exits 0 on any
#                                               # 2xx - so `curl -fsS … && echo OK`
#                                               # prints OK on a degraded instance.
#                                               # Read the JSON: it names the
#                                               # component. 503 = PostgreSQL
#                                               # unreachable.
#     curl -fsS http://127.0.0.1:3000/health    # frontend process only
#
# Real probes land with `vizra healthcheck` (vizra-core, queue 2h). THIS PARAGRAPH
# IS DELETED in the same PR that empties `known_false_probes` in
# scripts/compose-shapes.json, and the topology checker enforces both halves:
# known-false-undisclosed fails if the list stands without this paragraph,
# known-false-stale-disclosure fails if this paragraph outlives the list.


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
VIZRA_STORAGE_PREFIX=default


# -----------------------------------------------------------------------------
# Search (vizra-core's view: off | managed | external)
# -----------------------------------------------------------------------------
# `off` is the default until M3 (Q-001). `managed` additionally needs
# `--profile search` on the compose command so the container exists at all;
# `external` needs VIZRA_SEARCH_URL pointed at your own deployment.
# A configured-but-unreachable search is a doctor FAIL and a degraded readiness
# signal while results are still served from SQL. It is never a hard dependency.
VIZRA_SEARCH_MODE=off
VIZRA_SEARCH_URL=http://search:8081
VIZRA_SEARCH_TIMEOUT=2s


# -----------------------------------------------------------------------------
# vizra-search's own bounds (only meaningful with --profile search)
# -----------------------------------------------------------------------------
# vizra-search refuses a body above 8 MiB and a skew above 300s in production.
MAX_INTERNAL_BODY_BYTES=1048576
VIZRA_SEARCH_MAX_CLOCK_SKEW=300s
VIZRA_SEARCH_REQUEST_TIMEOUT=5s
VIZRA_SEARCH_SHUTDOWN_GRACE=15s


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Both the default deadline and the ceiling a caller cannot exceed.
API_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# Request and job bounds
# -----------------------------------------------------------------------------
# Leave VIZRA_CORS_ALLOWED_ORIGINS empty unless a separate origin must call the
# API. A wildcard is refused in production.
VIZRA_CORS_ALLOWED_ORIGINS=
# Refused in production. Present so `vizra doctor` can name it rather than have
# an operator discover it from a stack trace.
VIZRA_ALLOW_INSECURE_PUBLIC_ORIGIN=
# Oldest-queued-job age above this turns readiness degraded and doctor red.
VIZRA_QUEUE_AGE_THRESHOLD=15m
# How many derivative jobs run at once. libvips is memory-hungry and the worker
# is the only process that decodes pixels, so this is the knob that decides
# whether the host survives a burst.
#   1  on the minimum supported host (2 vCPU / 4 GB)
#   2  shipped default
#   4  from 8 GB up
# Raise VIZRA_WORKER_MEM_LIMIT with it.
VIZRA_WORKER_CONCURRENCY=2
VIZRA_JOB_LEASE=60s
VIZRA_JOB_TIMEOUT=5m
VIZRA_SHUTDOWN_GRACE=20s
# How long a migration waits for its lock before failing the deploy. Failing is
# the point: a migration that blocks indefinitely holds the database while api
# and worker queue up behind it.
VIZRA_MIGRATE_LOCK_TIMEOUT=5s


# -----------------------------------------------------------------------------
# Memory caps (production overlay only)
# -----------------------------------------------------------------------------
# CAPS ON PEAK, NOT RESERVATIONS. They deliberately sum above the 4 GB floor
# host: the job they do is containment, not scheduling. Without a cgroup limit
# anywhere, a burst of concurrent libvips decodes exhausts RAM and the kernel
# OOM killer picks by badness score — which on a Docker host is routinely
# PostgreSQL, the largest resident process. A limit that OOM-kills the worker is
# recoverable; one that OOM-kills PostgreSQL means crash recovery on restart.
#
# Defaults are sized for 2 vCPU / 4 GB at the SHIPPED VIZRA_WORKER_CONCURRENCY=2
# (above). On the 4 GB floor host run concurrency 1; the caps still hold, with
# more headroom. Raise both together on a larger host; see the capacity note in
# docs/quality/COMMANDS.md for the reasoning and the arithmetic.
VIZRA_POSTGRES_MEM_LIMIT=768m
VIZRA_REDIS_MEM_LIMIT=384m
VIZRA_API_MEM_LIMIT=768m
VIZRA_WORKER_MEM_LIMIT=1500m
VIZRA_FRONTEND_MEM_LIMIT=512m
# The edge is the one container whose death is total site downtime, so it gets
# headroom rather than the tightest cap in the stack.
VIZRA_CADDY_MEM_LIMIT=160m
VIZRA_MIGRATE_MEM_LIMIT=256m
VIZRA_SEARCH_MEM_LIMIT=256m
# Not sized for the floor host; enabling either profile on 4 GB is unsupported.
VIZRA_CLICKHOUSE_MEM_LIMIT=1g
VIZRA_IPFS_MEM_LIMIT=768m

# PostgreSQL's /dev/shm. Docker's default is 64 MiB, which is enough to START a
# cluster and not enough to run a parallel query — so this fails MONTHS after
# install, once a table is large enough for the planner to go parallel:
#     ERROR: could not resize shared memory segment "/PostgreSQL.NNNNNNN" to
#     NNNNNN bytes: No space left on device
# on a host with gigabytes of disk free. If you are reading this because you
# searched for that message: this is the setting. Under cgroup v2 /dev/shm is
# charged to the postgres container's memory cap, so raise
# VIZRA_POSTGRES_MEM_LIMIT alongside it.
VIZRA_POSTGRES_SHM_SIZE=256m


# -----------------------------------------------------------------------------
# Optional: analytics (--profile analytics)
# -----------------------------------------------------------------------------
# OFF by default: without the profile no container exists. Nothing in Vizra
# connects to ClickHouse yet — these configure the bundled server only.
CLICKHOUSE_USER=vizra
CLICKHOUSE_DB=vizra
CLICKHOUSE_PASSWORD=


# -----------------------------------------------------------------------------
# Optional: IPFS (--profile ipfs)
# -----------------------------------------------------------------------------
# OFF by default. With the profile on, the swarm port 4001 is published and
# FACES THE NETWORK — that is required for a node to be dialled, and it is the
# only non-edge port in the whole topology that does. Gate it in your cloud
# firewall. The Kubo HTTP API is never published; publishing it is remote
# control of the node.
IPFS_PROFILE=server

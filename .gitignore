# Component repositories are nested checkouts with their own history (docs/META_REPO.md)
/vizra-core/
/vizra-user/
/vizra-search/

# War-room worktrees and local agent state
/.claude/worktrees/
/.claude/settings.local.json
/.claude/hooks/.state/

# Secrets and local environment — only *.env.example is tracked
/env/*.env
.env
.env.*
!.env.example
!*.env.example

.DS_Store

# Rendered compose models (regenerated by scripts/compose-render.py)
/build/
# CI artifact staging. The `validate` lane copies the rendered models here for
# actions/upload-artifact, and docs/evidence/compose-topology/demo.sh asserts
# the tree is byte-identical after its mutations - an untracked ci-report/ would
# fail that assertion for a reason that has nothing to do with the guards.
/ci-report/
# Generated by `vizra setup` from deploy/Caddyfile.template; holds the operator's domain
/deploy/Caddyfile.local
